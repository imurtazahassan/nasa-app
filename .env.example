# GEMINI_API_KEY: Server-side Gemini API key (automatically injected by AI Studio Secrets or set on your Node host).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Server-side NASA FIRMS 375m MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
VITE_NASA_FIRMS_KEY=
